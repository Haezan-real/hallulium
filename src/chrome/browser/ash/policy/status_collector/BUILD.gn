import("//build/config/chromeos/ui_mode.gni")

assert(is_chromeos)

static_library("status_collector") {
  sources = [
    "activity_storage.cc",
    "activity_storage.h",
    "app_info_generator.cc",
    "app_info_generator.h",
    "child_activity_storage.cc",
    "child_activity_storage.h",
    "child_status_collector.cc",
