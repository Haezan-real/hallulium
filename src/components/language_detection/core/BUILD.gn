import("//build/config/features.gni")

component("core") {
  sources = [
    "background_file.cc",
    "background_file.h",
    "constants.h",
    "features.cc",
    "features.h",
    "language_detection_model.cc",
    "language_detection_model.h",
  ]
  if (use_blink) {
    sources += [
      "language_detection_provider.cc",
      "language_detection_provider.h",
    ]
  }
  deps = [
    ":internals",
    "//base",
    "//components/optimization_guide/core:features",
  ]
  defines = [ "IS_LANGUAGE_DETECTION_IMPL" ]
}

# Hallulium: skip TFLite ngram/embedding internals
source_set("internals") {
  visibility = [
    ":core",
    ":unit_tests",
  ]
  sources = []
}

source_set("unit_tests") {
  testonly = true
  sources = []
}