+void SurfaceAggregator::DeliverHaezansResult(
+    const gfx::Rect& rect,
+    std::unique_ptr<CopyOutputResult> result) {
+  if (!result || result->IsEmpty() || !haezans_callback_ ||
+      !result->GetSharedImage()) {
+    return;
+  }
+  const gfx::Size size = result->size();
+  if (size.IsEmpty())
+    return;
+  const uint32_t token = ++haezans_next_result_;
+  haezans_results_.emplace(token, std::move(result));
+  haezans_callback_.Run(gfx::Rect(rect.origin(), size), token);
+}
+
+std::unique_ptr<CopyOutputResult> SurfaceAggregator::TakeHaezansResult(
+    uint32_t token) {
+  auto found = haezans_results_.find(token);
+  if (found == haezans_results_.end())
+    return nullptr;
+  auto result = std::move(found->second);
+  haezans_results_.erase(found);
+  return result;
+}
