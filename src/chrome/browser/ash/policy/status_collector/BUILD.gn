    "enterprise_activity_storage.h",
    "managed_session_service.cc",
    "managed_session_service.h",
    "status_collector.cc",
    "status_collector.h",
    "status_collector_state.cc",
    "status_collector_state.h",
    "tpm_status_combiner.cc",
    "tpm_status_combiner.h",
