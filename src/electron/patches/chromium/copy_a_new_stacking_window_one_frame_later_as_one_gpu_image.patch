+
+void RootCompositorFrameSinkImpl::OnHaezansRegion(const gfx::Rect& rect,
+                                                  uint32_t token) {
+  auto result = display_->TakeHaezansResult(token);
+  if (!result || !haezans_client_.is_bound())
+    return;
+  scoped_refptr<gpu::ClientSharedImage> shared = result->GetSharedImage();
+  if (!shared)
+    return;
+  gpu::SyncToken sync_token = shared->creation_sync_token();
+  gpu::ExportedSharedImage exported = shared->Export();
+  haezans_held_.emplace(token, std::move(result));
+  haezans_client_->OnRegion(token, rect, std::move(exported), sync_token);
+}
+
+void RootCompositorFrameSinkImpl::ReleaseHaezansCapture(
+    uint32_t token,
+    const gpu::SyncToken& sync_token) {
+  auto found = haezans_held_.find(token);
+  if (found == haezans_held_.end())
+    return;
+  viz::ReleaseCallback release = found->second->TakeSharedImageOwnership();
+  if (release)
+    std::move(release).Run(sync_token, false);
+  haezans_held_.erase(found);
+}
+
+void RootCompositorFrameSinkImpl::OnHaezansClientDisconnected() {
+  haezans_held_.clear();
+  display_->SetHaezansDomCapture(std::nullopt, {});
 }
 
