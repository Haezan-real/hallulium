+// Rectangles that nearly touch belong to one window. Grow, union, and repeat
+// so a chain of layers becomes one copy instead of one rectangle per layer.
+std::vector<gfx::Rect> ClusterCaptureRects(std::vector<gfx::Rect> rects) {
+  constexpr int kSlack = 16;
+  bool merged = true;
+  while (merged) {
+    merged = false;
+    for (size_t i = 0; i < rects.size(); ++i) {
+      if (rects[i].IsEmpty())
+        continue;
+      gfx::Rect grown = rects[i];
+      grown.Inset(-kSlack);
+      for (size_t j = i + 1; j < rects.size();) {
+        if (rects[j].IsEmpty()) {
+          rects.erase(rects.begin() +
+                      static_cast<std::vector<gfx::Rect>::difference_type>(j));
+          continue;
+        }
+        gfx::Rect other = rects[j];
+        other.Inset(-kSlack);
+        if (!grown.Intersects(other)) {
+          ++j;
+          continue;
+        }
+        rects[i].Union(rects[j]);
+        rects.erase(rects.begin() +
+                    static_cast<std::vector<gfx::Rect>::difference_type>(j));
+        grown = rects[i];
+        grown.Inset(-kSlack);
+        merged = true;
+      }
+    }
+  }
+  std::erase_if(rects, [](const gfx::Rect& rect) { return rect.IsEmpty(); });
+  return rects;
+}
