  # PCRE2 ships .generic/.dist templates instead of ready-to-use files
  # (see github.com/PCRE2Project/pcre2/blob/master/NON-AUTOTOOLS-BUILD).
  # Copy them to the expected names at build time.
  copy("pcre2_generated") {
    sources = [
    ]
    outputs = [ "$target_gen_dir/pcre2/{{source_name_part}}" ]
  }

  config("pcre2_config") {
    visibility = _buildtools_visibility
    include_dirs = [
      "$target_gen_dir/pcre2",
      "pcre2/src",
    ]
  }

  static_library("pcre2") {
    visibility = _buildtools_visibility
    deps = [ ":pcre2_generated" ]
    public_configs = [ ":pcre2_config" ]
    configs -= [ "//gn/standalone:extra_warnings" ]
    sources = [
      "$target_gen_dir/pcre2/pcre2_chartables.c",
    ]
    cflags = [
      "-DHAVE_CONFIG_H",
      "-DPCRE2_CODE_UNIT_WIDTH=8",
      "-DSUPPORT_JIT",
