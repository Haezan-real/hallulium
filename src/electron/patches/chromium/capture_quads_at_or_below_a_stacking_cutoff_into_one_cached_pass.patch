+void RootCompositorFrameSinkImpl::SetHaezansDomCapture(
+    bool enabled,
+    int32_t max_z,
+    mojo::PendingRemote<mojom::HaezansDomCaptureClient> client) {
+  if (!enabled || !client) {
+    haezans_client_.reset();
+    display_->SetHaezansDomCapture(std::nullopt, {});
+    return;
+  }
+  haezans_client_.Bind(std::move(client));
