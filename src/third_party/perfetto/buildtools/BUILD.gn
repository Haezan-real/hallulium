    defines = [ "RE2_USE_ABSL" ]
  }

  # Use source_set for WASM to avoid the alink step — macOS libtool rejects
  # emscripten .o files. For native builds, static_library is more efficient
  # as it deduplicates objects when multiple targets depend on RE2.
  if (is_wasm) {
    _re2_target_type = "source_set"
  } else {
    _re2_target_type = "static_library"
  }

  target(_re2_target_type, "re2") {
    visibility = _buildtools_visibility
    sources = [
    ]
    public_configs = [ ":re2_config" ]
    public_deps = [ ":abseil_cpp" ]
